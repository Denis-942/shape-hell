[node name="UpdateLogLabel" type="RichTextLabel" parent="CanvasLayer/Menus/MainMenu/ScrollContainer" unique_id=415475822]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/line_separation = 6
bbcode_enabled = true
text = "[center]1.0.0-[color=light_green]alpha[/color][/center][font_size=12][ul]
added a wave system
added a level system
added an ammo system
added a new weapon
rebalanced weapons and enemies
fixed some bugs
and more
[/ul]
[/font_size]
[center]1.2.0-[color=light_blue]prototype[/color][/center][font_size=12][ul]
added a rarity system
added a score system (saves locally)
added 4 new (burst) weapons
added new enemy types
added inventory weapon tooltips
added player passive health regeneration
enemies now change color based on their health percentage
weapons on ground now despawn after a set amount of time (time depends on rarity)
fixed some bugs
and more
[/ul]
[/font_size]
[center]1.1.0-[color=light_blue]prototype[/color][/center][font_size=12][ul]
added an inventory system
added 5 new weapons
enemies now have a chance to drop a weapon on death
updated main menu
[/ul]
[/font_size]
[center]1.0.1-[color=light_blue]prototype[/color][/center][font_size=12][ul]
fixed a bug making the player being unable to kill after one death
enemies are now killed after a restart
[/ul]
[/font_size]
[center]1.0.0[color=light_blue]p[/color][/center][font_size=12][ul]
The first prototype version release
[/ul]
[/font_size]"
fit_content = true

